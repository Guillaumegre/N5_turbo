{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "docs",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3.12", "-m", "http.server", "8090", "--bind", "127.0.0.1", "--directory", "docs"],
      "port": 8090
    }
  ]
}
